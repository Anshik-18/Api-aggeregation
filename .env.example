# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL
POSTGRES_PORT=5434
POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=gateway_secret
POSTGRES_DB=api_gateway
DATABASE_URL=postgresql://gateway_user:gateway_secret@localhost:5434/api_gateway

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Mock Upstream Providers
MOCK_PROVIDER_ALPHA_LATENCY_MS=80
MOCK_PROVIDER_ALPHA_PRICE=0.001000
MOCK_PROVIDER_ALPHA_FAIL_RATE=0.0

MOCK_PROVIDER_BETA_LATENCY_MS=30
MOCK_PROVIDER_BETA_PRICE=0.003000
MOCK_PROVIDER_BETA_FAIL_RATE=0.0

# Circuit Breakers & Routing
ROUTING_MAX_RETRIES=2
PROVIDER_METRICS_WINDOW_MS=60000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=10000
CIRCUIT_BREAKER_ERROR_RATE_THRESHOLD=0.5
CIRCUIT_BREAKER_MIN_REQUESTS=5

# Response Caching & Request Coalescing
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_COALESCING_TIMEOUT_MS=3000
CACHE_DISCOUNT_PERCENT=50

# Distributed Rate Limiting
RATE_LIMIT_DEFAULT_WINDOW_MS=1000
RATE_LIMIT_DEFAULT_MAX=50
RATE_LIMIT_FALLBACK_POLICY=FAIL_OPEN_LOCAL_FALLBACK
